{
  "name": "topivappa-pos-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Topi Vappa POS - Windows Desktop Edition with Silent Direct Printing",
  "main": "electron/main.cjs",
  "author": "Topi Vappa",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win",
    "publish": "npm run build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.topivappa.pos",
    "productName": "Topi Vappa POS",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "ilanchezhian-m",
      "repo": "pos-upgraded-version"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../sync-server",
        "to": "sync-server",
        "filter": [
          "**/*",
          "!node_modules/.cache",
          "!orders.json",
          "!bills.json",
          "!prints.json",
          "!.*vault*.json",
          "!*vault*.json"
        ]
      },
      {
        "from": "../captain-app/dist",
        "to": "captain-app/dist"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Topi Vappa POS"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^7.2.4",
    "wait-on": "^8.0.1"
  }
}
